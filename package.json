{
  "name": "libresplit-website",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://libresplit.org",
  "type": "module",
  "scripts": {
    "test": "npm run format:test && tsc -b && npm run lint",
    "lint": "npx oxlint -c oxlint.config.ts src vite.config.ts",
    "lint:fix": "npm run lint -- --fix",
    "format:test": "oxfmt -c oxfmt.config.ts --check .",
    "format:write": "oxfmt -c oxfmt.config.ts --write .",
    "format:write:files": "oxfmt -c oxfmt.config.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.13",
    "@libresplit/converter": "^1.0.0",
    "@solid-primitives/storage": "^4.4.0",
    "@solidjs/router": "^1.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/solid-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "lucide-solid": "^1.33.0",
    "marked": "^18.0.10",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-highlight": "^2.2.4",
    "shiki": "^4.4.3",
    "solid-js": "^1.9.15",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "eslint-plugin-solid": "^0.15.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-sitemap": "^0.8.2",
    "vite-plugin-solid": "^2.11.14"
  }
}
