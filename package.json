{
  "name": "libresplit-website",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://libresplit.org",
  "type": "module",
  "scripts": {
    "test": "npm run format:test && tsc -b && npm run lint",
    "lint": "npx oxlint -c oxlint.config.ts src vite.config.ts",
    "format:test": "oxfmt -c .oxfmtrc.json --check .",
    "format:write": "oxfmt -c .oxfmtrc.json --write .",
    "format:write:files": "oxfmt -c .oxfmtrc.json",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.13",
    "@libresplit/converter": "^1.0.0",
    "@solid-primitives/storage": "^4.4.0",
    "@solidjs/router": "^1.0.0",
    "@tanstack/solid-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-solid": "^1.33.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "prism-themes": "^1.9.0",
    "prismjs": "^1.30.0",
    "solid-js": "^1.9.15",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/prismjs": "^1.26.6",
    "eslint-plugin-solid": "^0.15.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-sitemap": "^0.8.2",
    "vite-plugin-solid": "^2.11.14"
  }
}
